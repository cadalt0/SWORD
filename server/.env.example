# Copy to .env and fill in. The same database, RPC and relayer key as the website (web/.env.local).
PORT=4000
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# One RPC per chain. Optional: each chain falls back to its public endpoint.
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
ARC_RPC_URL=https://rpc.testnet.arc.io
# The relayer that deployed the contracts on every chain. Signs for custodial merchants and within merchants' permissions.
RELAYER_PRIVATE_KEY=0x...
# Where the Sword website runs. Checkout links point here; actions are recorded through it.
PUBLIC_WEB_URL=http://localhost:3000
# The same value as INTERNAL_API_SECRET in web/.env.local.
INTERNAL_API_SECRET=
# Per API key, per minute. Writes send transactions, so they get a lower limit.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=30
# How long a prepared transaction for a self-signing merchant stays valid.
PENDING_MINUTES=15
